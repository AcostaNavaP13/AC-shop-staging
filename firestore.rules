rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // El cliente público solo puede DECREMENTAR el stock al comprar (nunca aumentar)
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'sizes'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.quantity <= resource.data.quantity
        );
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // Solo el admin puede ver la lista completa de cupones
      allow list: if isAdmin();
      // Cualquiera puede buscar un cupón individual (para validar código en el carrito)
      allow get: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByIps'])
          && request.resource.data.usedByIps is list
        );
    }

    match /orders/{orderId} {
      // Cualquiera puede CREAR un pedido (al comprar) con estructura válida
      allow create: if request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'pending';
      // Solo el admin puede leer, modificar o cancelar pedidos
      allow read, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isAdmin() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
